{
  "name": "cerebras-code-mcp",
  "version": "1.2.0",
  "description": "Model Context Protocol (MCP) server for Cerebras Code API integration with any MCP-compatible client. Run 'cerebras-mcp --config' for interactive setup.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "cerebras-mcp": "src/index.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node src/index.js",
    "dev": "node src/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "cerebras",
    "ai",
    "code-generation",
    "llm",
    "artificial-intelligence",
    "developer-tools",
    "cursor",
    "claude",
    "mcp-server"
  ],
  "author": "Kevin Taylor <kevin.taylor@cerebras.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevint-cerebras/cerebras-code-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kevint-cerebras/cerebras-code-mcp/issues"
  },
  "homepage": "https://github.com/kevint-cerebras/cerebras-code-mcp#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "diff": "^8.0.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "prettier": "3.8.1",
    "vitest": "^4.0.18"
  }
}
